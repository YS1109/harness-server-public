# Copy to .env, then set a locally generated token of at least 32 characters.
# Generate one with: openssl rand -hex 32
# Intentionally empty: this is not a usable credential.
HARNESS_TOKEN=
# Optional browser account. Generate the Argon2id PHC hash with
# `harness-server hash-password` (interactive hidden input).
# Keep the hash in a single-quoted .env value so `$` is not interpolated.
HARNESS_ADMIN_USERNAME=
HARNESS_ADMIN_PASSWORD_HASH=
# Optional independent admin API/bootstrap token; not the Agent token.
HARNESS_ADMIN_TOKEN=
# HTTPS deployments keep true. Set false only for explicit localhost HTTP tests.
HARNESS_ADMIN_SECURE_COOKIE=true
# Optional: used only by compose.image.yaml, after the first successful publication.
# Pin a version tag or digest for deployments that require an immutable image.
HARNESS_IMAGE=ghcr.io/ys1109/harness-server-public:latest
