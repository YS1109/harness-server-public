# Copy to .env, then set a locally generated token of at least 32 characters.
# Generate one with: openssl rand -hex 32
# Intentionally empty: this is not a usable credential.
HARNESS_TOKEN=
# Optional: used only by compose.image.yaml, after the first successful publication.
# Pin a version tag or digest for deployments that require an immutable image.
HARNESS_IMAGE=ghcr.io/ys1109/harness-server-public:latest
